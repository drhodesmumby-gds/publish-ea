    pins -.->|"Retrieves case record (planned)"| case

    classDef person fill:#0b0c0c,stroke:#0b0c0c,stroke-width:2px,color:#ffffff
    classDef better fill:#00703c,stroke:#00703c,stroke-width:2px,color:#ffffff
    classDef system fill:#ffffff,stroke:#505a5f,stroke-width:2px,color:#0b0c0c

    class officer,pins,pdp person
    class case better
    class notice,notify,register system

    linkStyle 0 stroke:#0b0c0c,stroke-width:3px
    linkStyle 1 stroke:#00703c,stroke-width:3px
    linkStyle 2 stroke:#00703c,stroke-width:3px
    linkStyle 3 stroke:#00703c,stroke-width:3px
    linkStyle 4 stroke:#00703c,stroke-width:3px
    linkStyle 5 stroke:#1d70b8,stroke-width:2px