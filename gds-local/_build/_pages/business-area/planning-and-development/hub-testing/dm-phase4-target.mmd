        officer["`**Case officer**`"]
        case["`**Case management**
        Decision recorded as data`"]
    end

    subgraph outputs["Triggered by the decision"]
        notice["`**Decision notice**
        Generated from the record`"]
        notify["`**Notifications**
        Applicant and interested parties`"]
        register["`**Public register**`"]
    end

    subgraph external["External"]
        pdp["`**Planning Data Platform**`"]
        pins["`**Planning Inspectorate**
        If appealed`"]
    end

    officer -->|"Records decision"| case
    case --> notice
    case --> notify
    case --> register
